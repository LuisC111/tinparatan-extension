{
  "manifest_version": 3,
  "name": "Tinparatan",
  "version": "1.2.1",
  "description": "Nueva pestaña, tema y arranque a tu medida. Todo se queda en este equipo.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Tinparatan",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "unlimitedStorage",
    "favicon"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/complete/*",
    "https://duckduckgo.com/ac/*",
    "https://search.brave.com/api/suggest*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
